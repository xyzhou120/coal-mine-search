# ============================================================
# 煤矿文档检索系统 - 环境变量配置
# 使用方法：复制此文件为 .env，然后填写各项配置
# ============================================================

# ------------------------------------------------------------
# PostgreSQL 数据库配置
# ------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=coal_mine_search
POSTGRES_USER=coal_mine
POSTGRES_PASSWORD=your_postgres_password_here
DATABASE_URL=postgresql+asyncpg://coal_mine:your_postgres_password_here@postgres:5432/coal_mine_search

# ------------------------------------------------------------
# Redis 配置（Celery 任务队列）
# ------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ------------------------------------------------------------
# Celery Worker 配置
# ------------------------------------------------------------
# Worker 并发数，建议根据 LLM 服务器负载调整，初始推荐 5
CELERY_WORKER_CONCURRENCY=5

# ------------------------------------------------------------
# MinIO 文件下载配置
# ------------------------------------------------------------
# 是否验证 SSL 证书（内网自签证书请设为 false）
MINIO_VERIFY_SSL=false
# 下载超时时间（秒）
MINIO_DOWNLOAD_TIMEOUT=120
# 下载重试次数
MINIO_DOWNLOAD_MAX_RETRIES=3

# ------------------------------------------------------------
# 文件存储路径配置
# ------------------------------------------------------------
# PageIndex 索引存储根目录（按 mine_code 隔离）
PAGEINDEX_STORAGE_ROOT=/data/pageindex_index
# 临时文件目录（文件下载和预处理用，处理完后自动清理）
TEMP_FILE_DIR=/data/temp
# Excel 上传目录
UPLOAD_DIR=/data/uploads

# ------------------------------------------------------------
# PageIndex Local 模式 - 索引构建模型
# 用于将文档解析为树形索引结构，需要较强的理解能力
# 推荐使用 Qwen 系列模型
# ------------------------------------------------------------
PAGEINDEX_INDEX_API_BASE_URL=http://your-llm-server:8000/v1
PAGEINDEX_INDEX_API_KEY=your_api_key_here
# 索引模型名称，如：qwen3-27b、qwen2.5-72b 等
PAGEINDEX_INDEX_MODEL_NAME=qwen3-27b

# ------------------------------------------------------------
# PageIndex Local 模式 - 检索推理模型（Chat 模型）
# 用于在树形索引上进行推理检索，回答用户问题
# 推荐使用与索引相同或更强的模型
# ------------------------------------------------------------
PAGEINDEX_CHAT_API_BASE_URL=http://your-llm-server:8000/v1
PAGEINDEX_CHAT_API_KEY=your_api_key_here
# Chat 模型名称，如：qwen3-27b、qwen2.5-72b 等
PAGEINDEX_CHAT_MODEL_NAME=qwen3-27b

# ------------------------------------------------------------
# 视觉模型配置（用于处理扫描件、复杂图表、手写体）
# 需要支持图片输入的多模态模型
# ------------------------------------------------------------
VISION_API_BASE_URL=http://your-vision-server:8000/v1
VISION_API_KEY=your_api_key_here
# 视觉模型名称，如：qwen3-vl-27b
VISION_MODEL_NAME=qwen3-vl-27b
# 单次 OCR 请求超时时间（秒），复杂文档可适当增大
VISION_REQUEST_TIMEOUT=120

# ------------------------------------------------------------
# PaddleOCR-VL 模型配置（用于文字识别，优先于视觉模型处理纯文字提取）
# ------------------------------------------------------------
PADDLEOCR_API_BASE_URL=http://your-paddleocr-server:8000/v1
PADDLEOCR_API_KEY=your_api_key_here
# PaddleOCR 模型名称
PADDLEOCR_MODEL_NAME=paddleocr-vl
# PaddleOCR 请求超时时间（秒）
PADDLEOCR_REQUEST_TIMEOUT=60

# ------------------------------------------------------------
# Embedding 模型配置（预留，用于后续语义增强检索）
# ------------------------------------------------------------
EMBEDDING_API_BASE_URL=http://your-embedding-server:8000/v1
EMBEDDING_API_KEY=your_api_key_here
# Embedding 模型名称，如：qwen-text-embedding
EMBEDDING_MODEL_NAME=qwen-text-embedding
# Embedding 向量维度
EMBEDDING_DIMENSIONS=1024

# ------------------------------------------------------------
# Reranker 模型配置（预留，用于检索结果重排序）
# ------------------------------------------------------------
RERANKER_API_BASE_URL=http://your-reranker-server:8000/v1
RERANKER_API_KEY=your_api_key_here
# Reranker 模型名称，如：qwen-reranker
RERANKER_MODEL_NAME=qwen-reranker
# Reranker 请求超时时间（秒）
RERANKER_REQUEST_TIMEOUT=30

# ------------------------------------------------------------
# PDF 文字层检测配置
# 少于此字符数的 PDF 页面视为扫描件，触发 OCR
# ------------------------------------------------------------
PDF_TEXT_THRESHOLD=50

# ------------------------------------------------------------
# 应用配置
# ------------------------------------------------------------
APP_ENV=production
APP_DEBUG=false
# API 访问密钥（可选，留空则不验证）
APP_API_KEY=
# 跨域配置（多个地址用逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
